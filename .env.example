# Copie para .env e ajuste.
# Neon: use a connection string DIRETA (sem "-pooler" no host) para permitir LISTEN/NOTIFY.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/hotel?sslmode=require
PORT=3000
# PIN do perfil Recepção
RECEPTION_PIN=1234
# Duração da pré-reserva (segundos)
HOLD_SECONDS=120
